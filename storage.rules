rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default rule - deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Allow public read access to posters
    match /posters/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Restrict film uploads and access to authenticated users
    match /films/{userId}/{fileName} {
      // Only allow the owner to read and write their own files
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow admin access
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Allow admin access to exports
    match /exports/{fileName} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}